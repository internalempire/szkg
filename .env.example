# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# Never commit .env. It contains credentials and is ignored by Git.

# Numeric Zotero user ID from https://www.zotero.org/settings/keys
ZOTERO_LIBRARY_ID=

# "user" for a personal library, or "group" for a shared group library.
ZOTERO_LIBRARY_TYPE=user

# Create a read-only Zotero key at https://www.zotero.org/settings/keys/new
ZOTERO_API_KEY=

# Create an API key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
